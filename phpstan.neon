parameters:
    level: 6
    parallel:
        jobSize: 200
        maximumNumberOfProcesses: 1
    paths:
        - src
        - tests
        - benchmarks
        - bin/protoc-gen-omnibuf-php
        - bin/conformance-php
    excludePaths:
        - gen
    scanFiles:
        - stubs/omnibuf_native.stub.php
    treatPhpDocTypesAsCertain: false
